{
  "name": "qlosu-standalone",
  "version": "1.0.0",
  "author": {
    "name": "QLosu Contributors",
    "email": "zx539@users.noreply.github.com"
  },
  "description": "QLosu 量子编程平台独立本地运行版（Losu v2 + Qufu 声明式框架 + QuEST 4.2.0，WASM 编译）",
  "main": "apps/desktop/main.js",
  "scripts": {
    "start": "node apps/server/index.js",
    "code-server": "node apps/code-server/launch.js",
    "code-server:build": "node scripts/build-code-server.js",
    "code-server:download": "node scripts/fetch-code-server.js",
    "test:distribution": "node --test scripts/fetch-code-server.test.js",
    "test:all": "npm run test:distribution && npm run test:security && npm run continue:check && npm run losu:test && node extensions/qlosu-vscode/test/diagrams.test.js && node extensions/qlosu-vscode/test/flowchart-complex.test.js && node extensions/qlosu-vscode/test/agent.test.js && node extensions/qlosu-vscode/test/package.test.js && node apps/code-server/workbench-profile.test.js && npm run desktop:test && npm run test:workbench && npm run test:markdown && node extensions/qlosu-vscode/test/agent-tools.test.js && node extensions/qlosu-vscode/test/agent-integration.test.js",
    "extension:install": "npm --prefix extensions/qlosu-vscode install",
    "extension:package": "cd extensions/qlosu-vscode && npm run package",
    "continue:setup": "node scripts/configure-continue.js",
    "continue:check": "node scripts/check-continue.js",
    "smoke:local": "node scripts/smoke-local-startup.js",
    "test:security": "node apps/server/core/workspace.test.js",
    "lsp": "node language-server/losu-lsp/server.js",
    "runtime:versions": "node -e \"require('./runtime/manager').listVersions({workspace:process.cwd()}).then(x=>console.log(JSON.stringify(x,null,2)))\"",
    "losu": "node scripts/losu2-cli.js",
    "losu:build": "node scripts/losu2-cli.js build",
    "losu:test": "node --test scripts/losu2-cli.test.js",
    "desktop": "node scripts/launch-desktop.js",
    "desktop:check": "node scripts/check-electron.js",
    "desktop:test": "node electron/launcher.test.js && node electron/workbench.test.js",
    "pack": "npm run release:prepare && electron-builder --config electron-builder.config.cjs --dir",
    "dist": "npm run dist:linux",
    "losu1:build": "node scripts/build-losu1.js",
    "code-server:check": "node scripts/check-code-server-native.js",
    "code-server:repair": "node scripts/repair-code-server.js",
    "test:workbench": "node extensions/qlosu-vscode/test/workbench.test.js && node extensions/qlosu-vscode/test/manual.test.js && node extensions/qlosu-vscode/test/circuit.test.js && node runtime/runtime.test.js",
    "smoke:workbench": "node scripts/smoke-workbench-ui.js",
    "desktop:install": "node scripts/install-electron.js",
    "smoke:desktop": "node scripts/smoke-desktop.js",
    "release:prepare": "node scripts/prepare-release.js",
    "dist:linux": "npm run pack && node scripts/archive-linux.js",
    "dist:linux:packages": "npm run pack && node scripts/package-linux-native.js",
    "dist:windows": "npm run release:prepare && electron-builder --config electron-builder.config.cjs --win nsis portable",
    "dist:all": "npm run dist:linux:packages && npm run dist:windows",
    "test:markdown": "node apps/server/core/markdown.test.js",
    "smoke:markdown": "node scripts/smoke-markdown.js",
    "agent:check": "node scripts/check-agent.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "4.22.3",
    "highlight.js": "11.11.1",
    "katex": "^0.19.0",
    "marked": "^11.2.0",
    "monaco-editor": "0.52.2",
    "sanitize-html": "2.18.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "mermaid": "12.2.0"
  },
  "build": {
    "appId": "com.qlosu.ide",
    "productName": "QLosu-IDE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "apps/desktop/**/*",
      "apps/**/*",
      "extensions/qlosu-vscode/assets/**/*",
      "extensions/qlosu-vscode/extension.js",
      "extensions/qlosu-vscode/agent.js",
      "extensions/qlosu-vscode/diagram.js",
      "extensions/qlosu-vscode/circuit.js",
      "extensions/qlosu-vscode/manual.js",
      "extensions/qlosu-vscode/manual/**/*",
      "extensions/qlosu-vscode/api.js",
      "extensions/qlosu-vscode/package.json",
      "extensions/qlosu-vscode/language-configuration.json",
      "extensions/qlosu-vscode/syntaxes/**/*",
      "extensions/qlosu-vscode/vendor/**/*",
      "extensions/qlosu-vscode/language-server/**/*",
      "extensions/qlosu-vscode/node_modules/semver/**/*",
      "extensions/qlosu-vscode/node_modules/vscode-jsonrpc/**/*",
      "extensions/qlosu-vscode/node_modules/vscode-languageclient/**/*",
      "extensions/qlosu-vscode/node_modules/vscode-languageserver-protocol/**/*",
      "extensions/qlosu-vscode/node_modules/vscode-languageserver-types/**/*",
      "language-server/**/*",
      "runtime/**/*",
      "runtime/version.js",
      "config/continue/**/*",
      "docs/continue-ai.md",
      "docs/losu-build.md",
      "docs/flowchart-complex.losu",
      "scripts/configure-continue.js",
      "scripts/check-continue.js",
      "scripts/package-linux-native.js",
      "scripts/losu2-cli.js",
      "legacy/**/*",
      "qlosu.json.example",
      "apps/server/**/*",
      "server/**/*",
      "legacy/web-ide/www/**/*",
      "img/**/*",
      "wasm/**/*",
      "examples/**/*",
      "src/losu v2.0.0/**/*",
      "vendor/code-server/4.95.3/**/*",
      "src/QLosu/洛书语法/**/*",
      "!legacy/web-ide/www/vendor/drawio/LICENSE",
      "LICENSE",
      "开源组件声明.md",
      "node_modules/monaco-editor/min/**/*",
      "scripts/build-losu1.js"
    ],
    "extraResources": [],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "img/LOGO-app.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "img/LOGO-app.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "img/LOGO-app.png"
    }
  }
}
